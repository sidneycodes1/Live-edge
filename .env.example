# Server
NODE_ENV=development
PORT=4000
# F-017: DATABASE_URL points at a real Postgres. Leave it EMPTY for local/dev to
# use the embedded PGlite store (server/.data/pglite) with no external DB needed.
# Only set a real, reachable URL here; a placeholder host (e.g. "host") will fail
# the connection probe and (outside production) fall back to PGlite with a warning.
# In production a set DATABASE_URL that is unreachable is a hard boot error (no
# silent fallback) — that is intentional so real money/state is never misrouted.
DATABASE_URL=
ALLOW_PGLITE_IN_PROD=false
JWT_SECRET=change-me-to-at-least-32-chars-long-random-string
CORS_ORIGIN=http://localhost:5173
PANTA_MODE=hybrid
PANTA_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=
SOLANA_RPC_URL=
SIM_FEE_BPS=200
SIM_CREATOR_SHARE_BPS=2500
SIM_GRADUATION_VOLUME=100
SIM_LIQUIDITY_B=50
SIM_CREATE_FEE=1

# Twitch live integration (feature/twitch-live-integration)
# Register an app at https://dev.twitch.tv/console/apps (Website Integration,
# OAuth Redirect URL http://localhost:5173). Client ID + Secret are required for
# REAL Helix calls / embeds. Leave both blank to run in labeled demo/fallback
# mode — the app degrades gracefully and never crashes (same policy as PANTA_API_KEY).
# NEVER commit real creds; this file is placeholders only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# A reliably-live 24/7 channel login used as the guaranteed-working demo room.
# Swap for any always-live channel; it is configurable on purpose.
TWITCH_FALLBACK_CHANNEL=
# Embed `parent` = bare hosting domain, NO protocol (dev.twitch.tv/docs/embed/video-and-clips/).
# Local dev is served from localhost, so use localhost here. Set to your real
# deployed domain (e.g. liveedge.example.com) in production.
TWITCH_PARENT_DOMAIN=localhost
# Server-side cache TTL for the /api/twitch/live browse list (avoid hammering Helix).
TWITCH_CACHE_TTL_MS=45000

# Multi-source live feed — GET /api/live (docs/live-aggregation-spec.md §7).
# Merges Twitch → Kick → YouTube → Floor(Livepeer) into one LiveChannel[] with a
# never-empty ladder. EACH source is optional and creds-gated exactly like Twitch:
# a source is enabled purely by whether its creds/config exist (no kill-switch
# flag). Missing creds → that source contributes nothing and the grid still loads
# (never blank, never a crash). NEVER commit real creds.

# Kick Developer API — register at https://dev.kick.com (client-credentials app
# token, same flow as Twitch). Required for REAL Kick livestream calls.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CACHE_TTL_MS=45000

# YouTube Data API v3 — create an API key in Google Cloud (YouTube Data API v3
# enabled). YOUTUBE_QUERY seeds the currently-live broadcast search.
YOUTUBE_API_KEY=
YOUTUBE_QUERY=live
# Optional Tier-B multi-query (REPLACES YOUTUBE_QUERY when set). Pipe-separated,
# each with an optional operator label: "football live:Football|cricket live".
# Each query costs 100 search units per refresh — keep the list short.
# YOUTUBE_QUERIES=
YOUTUBE_CACHE_TTL_MS=45000

# Floor (Livepeer) — the guaranteed last rung of the ladder. FLOOR_FALLBACK_URL is
# a self-hosted / always-live HLS playback URL; setting it is what lets /api/live
# promise a NON-EMPTY grid even when every other source is down and nothing is
# cached. The other FLOOR_FALLBACK_* fields are cosmetic labels for that one card
# (no thumbnail is configurable — §1/§4 forbid fabricating a preview URL).
# LIVEPEER_API_KEY is optional (enables Livepeer Studio live discovery).
FLOOR_PROVIDER=livepeer
LIVEPEER_API_KEY=
FLOOR_HLS_BASE=https://stream.livepeer.com
FLOOR_FALLBACK_URL=
FLOOR_FALLBACK_TITLE=
FLOOR_FALLBACK_CHANNEL=
FLOOR_FALLBACK_CATEGORY=
FLOOR_CACHE_TTL_MS=45000

# Grid-level cache TTL for the merged /api/live result (§3 step 4).
LIVE_CACHE_TTL_MS=30000

# Privy auth (server) — docs/PRIVY_AUTH_SPEC.md. Lead-managed secrets; leave blank.
# PRIVY_APP_SECRET never leaves the server. The web app reads VITE_PRIVY_APP_ID from
# this ROOT .env (loaded by scripts/dev.mjs and inherited by Vite), NOT from a
# web/.env.local file.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Web
VITE_API_URL=http://localhost:4000
